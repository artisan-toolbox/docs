{
    "$schema": "https://www.schemastore.org/package.json",
    "version": "1.0.0-beta.2",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/build-brand-logos.mjs && vp build",
        "dev": "node scripts/build-brand-logos.mjs && vp dev",
        "test": "vp test run --config vite.test.config.js",
        "test:migration": "vp test run --config vite.migration.test.config.js",
        "standards:check": "node scripts/sync-agent-standards.mjs --check",
        "standards:sync": "node scripts/sync-agent-standards.mjs --write",
        "icons:build": "node scripts/build-icons.mjs && node scripts/build-brand-logos.mjs",
        "check": "vp check",
        "check:fix": "vp check --fix",
        "types:check": "vue-tsc --noEmit",
        "test:browser": "node scripts/test-demo-browser.mjs && node scripts/test-application-browser.mjs && node scripts/test-login-browser.mjs && node scripts/test-printing-browser.mjs && node scripts/test-localization-browser.mjs && node scripts/test-preferences-browser.mjs",
        "demos:sync": "node scripts/sync-front-awesome-demos.mjs",
        "demos:check": "node scripts/sync-front-awesome-demos.mjs --check",
        "test:printing": "node scripts/test-printing-browser.mjs",
        "test:localization": "node scripts/test-localization-browser.mjs",
        "test:preferences": "node scripts/test-preferences-browser.mjs"
    },
    "dependencies": {
        "@artisan-toolbox/front-awesome": "file:vendor/artisan-toolbox/front-awesome",
        "@artisan-toolbox/mosaicast": "file:vendor/artisan-toolbox/mosaicast",
        "@artisan-toolbox/qztray": "file:vendor/artisan-toolbox/qztray",
        "@awesome.me/webawesome": "^3.14.0",
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.0.0",
        "@vueuse/core": "^12.8.2",
        "@web.awesome.me/webawesome-pro": "^3.14.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-echo": "^2.6.3",
        "laravel-vite-plugin": "^3.0.0",
        "pusher-js": "^8.6.0",
        "reka-ui": "^2.9.8",
        "shiki": "^4.6.0",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-sonner": "^2.0.0",
        "ziggy-js": "^2.6.5"
    },
    "devDependencies": {
        "@laravel/echo-vue": "^2.6.3",
        "@primeuix/themes": "^2.0.3",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/test-utils": "^2.5.1",
        "concurrently": "^10.0.3",
        "fontaine": "^1.0.3",
        "happy-dom": "^21.0.4",
        "playwright": "^1.65.0",
        "primevue": "^4.5.5",
        "sharp": "^0.35.5",
        "typescript": "^5.2.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plus": "1.4.0",
        "vue-tsc": "^3.3.13"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
    },
    "engines": {
        "node": ">=24.11.0"
    }
}
