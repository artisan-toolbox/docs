    {
        "id": "OrderString",
        "guide": "dapter/field-order",
        "title": "Order strings",
        "description": "String order places Notebook 10 before Notebook 2.",
        "source": "Dapter.FieldsFluent",
        "request": {
            "version": 2,
            "state": {
                "version": 2,
                "fields": {},
                "global": {},
                "searchMatch": "all",
                "order": {
                    "kind": "fields",
                    "terms": [
                        {
                            "field": "name",
                            "direction": "asc",
                            "sortType": "string"
                        }
                    ]
                },
                "paging": {
                    "mode": "offset",
                    "current": 1,
                    "per_page": 4
                }
