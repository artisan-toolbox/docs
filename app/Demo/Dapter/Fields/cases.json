[
    {
        "id": "SearchContains",
        "guide": "dapter/field-search",
        "title": "Search literal punctuation",
        "description": "Contains treats % and _ as ordinary characters. The single matching row is Pencil 100%_!.",
        "source": "Dapter.FieldsFluent",
        "request": {
            "version": 2,
            "state": {
                "version": 2,
                "fields": {
                    "name": {
                        "search": {
                            "value": "100%_!",
                            "matchType": "contains"
                        }
                    }
                },
                "global": {},
                "searchMatch": "all",
                "order": {
                    "kind": "default"
                },
                "paging": {
                    "mode": "offset",
                    "current": 1,
                    "per_page": 4
                }
            }
        },
        "expected": {
            "status": 200,
            "ids": [3],
            "filtered": 1
        }
    },
