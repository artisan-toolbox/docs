[
    {
        "id": "LiteralDefault",
        "source": "Dapter.LiteralDefault",
        "guide": "dapter/literal-search",
        "title": "Default search matches the João variants",
        "description": "Input joao returns IDs 1 through 7, including mixed case, composed accents, and a decomposed accent. Tenant 2 remains excluded.",
        "request": {
            "version": 2,
            "state": {
                "version": 2,
                "fields": {
                    "name": {
                        "search": {
                            "value": "joao",
                            "matchType": "contains"
                        }
                    }
                },
                "global": {},
                "searchMatch": "all",
                "order": {
                    "kind": "default"
                },
                "paging": {
                    "mode": "offset",
                    "current": 1,
                    "per_page": 7
                }
            }
        },
        "expected": {
            "status": 200,
            "ids": [1, 2, 3, 4, 5, 6, 7],
            "total": 7,
            "filtered": 7
        }
    },
