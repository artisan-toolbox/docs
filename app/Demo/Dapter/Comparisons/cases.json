    {
        "id": "LiteralComparison",
        "source": "Dapter.ComparisonsLiteral",
        "guide": "dapter/collection-comparisons",
        "title": "Keep literal matching independent",
        "description": "The exact composed café input matches ID 1 only. ID 2 uses a decomposed accent and ID 3 has no accent. Locale ordering does not change literal search.",
        "request": {
            "version": 2,
            "state": {
                "version": 2,
                "fields": {
                    "name": {
                        "search": {
                            "value": "café",
                            "matchType": "contains"
                        }
                    }
                },
                "global": {},
                "searchMatch": "all",
                "order": {
                    "kind": "default"
                },
                "paging": {
                    "mode": "offset",
                    "current": 1,
                    "per_page": 6
                }
            }
        },
        "expected": {
            "status": 200,
            "ids": [1],
            "total": 6,
            "filtered": 1
        }
    },
