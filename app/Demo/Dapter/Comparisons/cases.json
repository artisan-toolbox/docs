[
    {
        "id": "LocaleFluent",
        "source": "Dapter.ComparisonsLocaleFluent",
        "guide": "dapter/collection-comparisons",
        "title": "Locale order through fluent declarations",
        "description": "Portuguese collation normalizes composed and decomposed accents, preserves their input order, and keeps numeric text collation disabled. Expected IDs: 4, 3, 1, 2, 6, 5.",
        "request": {
            "version": 2,
            "state": {
                "version": 2,
                "fields": {},
                "global": {},
                "searchMatch": "all",
                "order": {
                    "kind": "fields",
                    "terms": [
                        {
                            "field": "name",
                            "direction": "asc",
                            "sortType": "locale"
                        }
                    ]
                },
                "paging": {
                    "mode": "offset",
                    "current": 1,
                    "per_page": 6
                }
            }
        },
        "expected": {
            "status": 200,
            "ids": [4, 3, 1, 2, 6, 5],
            "total": 6,
            "filtered": 6
        }
    },
