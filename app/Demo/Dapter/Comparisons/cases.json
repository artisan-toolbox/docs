    {
        "id": "RegexRejected",
        "source": "Dapter.ComparisonsLiteral",
        "guide": "dapter/comparison-capabilities",
        "title": "Reject a forged regex after a valid filter",
        "description": "The active filter is valid. The regex search is not an admitted operation. The complete request fails before calling source() or doing row work.",
        "request": {
            "version": 2,
            "state": {
                "version": 2,
                "fields": {
                    "active": {
                        "filters": {
                            "active": {
                                "value": true
                            }
                        }
                    },
                    "name": {
                        "search": {
                            "value": "(a+)+$",
                            "matchType": "regex"
                        }
                    }
                },
                "global": {},
                "searchMatch": "all",
                "order": {
                    "kind": "default"
                },
                "paging": {
                    "mode": "offset",
                    "current": 1,
                    "per_page": 6
                }
            }
        },
        "expected": {
            "status": 422,
            "ids": [],
            "kind": "unsupported_operation"
        }
    }
