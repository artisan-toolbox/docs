{
    "version": 1,
    "cases": [
        {
            "id": "CollectionDefaults",
            "label": "Config defaults",
            "description": "StoreOptions::make() inherits paging and guard configuration. PublicAccess permits this fictional guest example.",
            "source": "Dapter.CollectionDefaults",
            "settings": [
                "StoreOptions.make",
                "config.access.guard",
                "config.paging.mode",
                "config.paging.per_page",
                "config.paging.per_page_options",
                "attribute.PublicAccess"
            ],
            "expected": {
                "status": 200,
                "per_page": 10,
                "options": [5, 10, 50, 100],
                "total": 23
            },
            "frame": "Config defaults",
            "behavior_test": "tests/Feature/DapterListingDemoTest.php",
            "component_test": "resources/js/components/demo/dapter/listing/ListingDemo.test.js",
            "guide": "dapter/listing",
            "page": "resources/js/pages/docs/dapter/Listing.vue"
        },
        {
